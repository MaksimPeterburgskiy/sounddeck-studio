{
  "name": "sounddeck-studio",
  "version": "0.1.0",
  "description": "Windows-first desktop soundboard with boards, hotkeys, local media, and virtual audio routing.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "start": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc && vite build",
    "test": "vitest run"
  },
  "keywords": [
    "electron",
    "soundboard",
    "windows",
    "audio",
    "hotkeys"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.3",
    "electron": "^39.2.6",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.2.7",
    "wait-on": "^9.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
