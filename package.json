{
  "name": "sounddeck-studio",
  "version": "0.1.10",
  "description": "Windows-first desktop soundboard with boards, hotkeys, local media, and virtual audio routing.",
  "main": "electron/main.cjs",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "start": "pnpm run build && concurrently -k \"pnpm run dev\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc && vite build",
    "dist": "node -e \"fs.rmSync('release', { recursive: true, force: true })\" && node scripts/fetch-vbcable.mjs && node scripts/make-installer-art.mjs && pnpm run build && electron-builder --win",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.sounddeck.studio",
    "productName": "SoundDeck Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/youtube-dl-exec/bin/**",
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "build/vbcable",
        "to": "vbcable"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp"
    },
    "publish": {
      "provider": "github",
      "owner": "MaksimPeterburgskiy",
      "repo": "sounddeck-studio",
      "releaseType": "release"
    }
  },
  "keywords": [
    "electron",
    "soundboard",
    "windows",
    "audio",
    "hotkeys"
  ],
  "author": "Maksim Peterburgskiy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaksimPeterburgskiy/sounddeck-studio.git"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.6.0"
  },
  "dependencies": {
    "cue-sdk": "^4.0.84",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "uiohook-napi": "^1.5.5",
    "youtube-dl-exec": "^3.1.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.10"
  }
}
