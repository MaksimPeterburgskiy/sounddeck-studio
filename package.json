{
  "name": "sounddeck-studio",
  "version": "0.1.12",
  "description": "Desktop soundboard for Windows and macOS with boards, hotkeys, local media, and virtual audio routing.",
  "main": "electron/main.cjs",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "start": "pnpm run build && concurrently -k \"pnpm run dev\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc && vite build",
    "clean:release": "node scripts/clean-release.mjs",
    "dist": "pnpm run dist:win",
    "dist:win": "pnpm run clean:release && node scripts/fetch-vbcable.mjs && node scripts/make-installer-art.mjs && pnpm run build && electron-builder --win",
    "dist:mac": "node scripts/dist-mac.mjs",
    "dist:mac:unsigned": "node scripts/dist-mac.mjs --unsigned",
    "fetch:yt-dlp:mac": "node scripts/fetch-ytdlp-mac.mjs",
    "build:blackhole": "node scripts/build-blackhole.mjs",
    "fix:macos-dev-signatures": "node scripts/codesign-macos-dev-deps.mjs",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.sounddeck.studio",
    "productName": "SoundDeck Studio",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/youtube-dl-exec/bin/**",
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/vbcable",
          "to": "vbcable"
        },
        {
          "from": "build/icon.ico",
          "to": "icon.ico"
        }
      ],
      "target": [
        "portable",
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}.${ext}",
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "x64ArchFiles": "**/node_modules/{cue-sdk,uiohook-napi}/prebuilds/**/*.node",
      "target": [
        "pkg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        },
        {
          "from": "build/trayTemplate.png",
          "to": "trayTemplate.png"
        },
        {
          "from": "build/trayTemplate@2x.png",
          "to": "trayTemplate@2x.png"
        },
        {
          "from": "build/blackhole/NOTICE.txt",
          "to": "blackhole/NOTICE.txt"
        },
        {
          "from": "build/yt-dlp",
          "to": "yt-dlp"
        }
      ],
      "binaries": [
        "Contents/Resources/yt-dlp/yt-dlp_macos"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "SoundDeck Studio uses your microphone only when mic passthrough or recording is enabled.",
        "NSInputMonitoringUsageDescription": "SoundDeck Studio uses input monitoring so global hotkeys can trigger sounds while another app is focused."
      }
    },
    "pkg": {
      "allowAnywhere": false,
      "allowCurrentUserHome": false,
      "allowRootDirectory": true,
      "extraPkgsDir": "extra-pkgs",
      "hasStrictIdentifier": true,
      "installLocation": "/Applications",
      "isRelocatable": false,
      "scripts": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp"
    },
    "publish": {
      "provider": "github",
      "owner": "MaksimPeterburgskiy",
      "repo": "sounddeck-studio",
      "releaseType": "release"
    }
  },
  "keywords": [
    "electron",
    "soundboard",
    "windows",
    "macos",
    "audio",
    "hotkeys"
  ],
  "author": "Maksim Peterburgskiy",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaksimPeterburgskiy/sounddeck-studio.git"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.6.0"
  },
  "dependencies": {
    "cue-sdk": "^4.0.84",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "uiohook-napi": "^1.5.5",
    "youtube-dl-exec": "^3.1.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.10"
  }
}
